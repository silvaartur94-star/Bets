# SQLite file for local use. Switch provider to "postgresql" in prisma/schema.prisma for Vercel.
DATABASE_URL="file:./dev.db"

# https://dashboard.api-football.com — free plan: 100 requests/day. Leave empty to use mock data.
API_FOOTBALL_KEY=""

# https://console.anthropic.com — leave empty to use the heuristic fallback analyst.
ANTHROPIC_API_KEY=""

# Optional: protects the dashboard with HTTP Basic Auth (any username).
DASHBOARD_PASSWORD=""

# Protects /api/cron/daily. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Requests per minute your API-Football plan allows (free = 10). Raise it on a paid plan to update faster.
API_FOOTBALL_PER_MINUTE=""
